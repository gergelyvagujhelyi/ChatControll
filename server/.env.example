# ChatControll Relay Server Configuration
# Copy to .env and fill in values.

DATABASE_URL=sqlite+aiosqlite:///./chatcontroll.db
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/chatcontroll

# Firebase Cloud Messaging (optional — set path to service account JSON)
# FIREBASE_CREDENTIALS=./firebase-service-account.json

# Server
HOST=0.0.0.0
PORT=8000
# Set to true ONLY for local development
DEBUG=false

# Metrics endpoint bearer token (endpoint disabled in production if unset)
# METRICS_TOKEN=your-secret-metrics-token

# CORS — comma-separated allowed origins (empty = block all cross-origin in prod)
# CORS_ORIGINS=https://your-domain.com

# Rate limiting
MAX_MESSAGES_PER_MINUTE=60
MAX_PENDING_MESSAGES_PER_USER=1000

# Pending message TTL (days) — messages older than this are purged hourly
# PENDING_MESSAGE_TTL_DAYS=30

# Request body limit (bytes)
# MAX_REQUEST_BODY_BYTES=2097152

# WebSocket idle timeout (seconds)
# WS_IDLE_TIMEOUT_SECONDS=300

# TURN server (coturn Docker container)
# Auto-detected from GCP metadata if unset. Override for non-GCP deployments.
# TURN_RELAY_IP=
# Shared secret for ephemeral TURN credentials (must match coturn config)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TURN_SECRET=
# TURN_CREDENTIAL_TTL=3600

# --- Docker Compose only ---
# POSTGRES_PASSWORD=change-me-to-a-strong-random-password
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem
