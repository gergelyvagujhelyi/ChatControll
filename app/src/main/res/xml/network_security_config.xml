<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: certificate pinning for the relay server.
         Replace LEAF_SPKI_HASH and BACKUP_CA_SPKI_HASH with actual SHA-256
         Subject Public Key Info hashes before production deployment.
         Generate with:
           openssl s_client -connect api.chatcontroll.vagujhelyigergely.com:443 \
             | openssl x509 -pubkey -noout \
             | openssl pkey -pubin -outform der \
             | openssl dgst -sha256 -binary | openssl enc -base64
    -->
    <domain-config>
        <domain includeSubdomains="true">api.chatcontroll.vagujhelyigergely.com</domain>
        <pin-set expiration="2027-10-01">
            <!-- Leaf certificate pin (primary) -->
            <pin digest="SHA-256">LEAF_SPKI_HASH=</pin>
            <!-- Intermediate CA pin (backup — prevents lockout on cert rotation) -->
            <pin digest="SHA-256">BACKUP_CA_SPKI_HASH=</pin>
        </pin-set>
    </domain-config>

    <!-- Debug: allow cleartext for local development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">chatcontroll.local</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
